{
  "name": "kte-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "audit": "node scripts/audit.mjs",
    "audit:reduced": "node scripts/audit.mjs --reduced",
    "audit:scene": "node scripts/verify-scene.mjs",
    "audit:live": "node scripts/audit.mjs --live",
    "audit:all": "npm run lint && npm run typecheck && npm run build && npm run audit && npm run audit:reduced && npm run audit:scene",
    "shoot": "node scripts/shoot.mjs",
    "layout": "node scripts/layout.mjs",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "maath": "^0.10.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
